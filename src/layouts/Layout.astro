---
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    {import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN && (
        <script
            defer
            src="https://static.cloudflareinsights.com/beacon.min.js"
            data-cf-beacon={`{"token": "${import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN}"}`}
        ></script>
    )}
    <style is:global>
        @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;700&family=JetBrains+Mono:wght@400;700&display=swap');

        :root {
            --bg-color: #020617;
            --card-bg: #0f172a;
            --text-main: #f3f4f6;
            --text-muted: #9ca3af;
            --accent: #06b6d4;
            --accent-glow: rgba(6, 182, 212, 0.2);
            --font-title: 'Space Grotesk', sans-serif;
            --font-body: 'JetBrains Mono', monospace;
        }
        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: var(--font-body);
            margin: 0;
            padding: 0;
        }
        .container {
            max-width: 1000px;
            margin: 0 auto;
            padding: 2rem;
        }
        h1, h2, h3, h4, h5, h6 {
            font-family: var(--font-title);
        }
    </style>
    <script defer src="https://cloud.umami.is/script.js" data-website-id="1fd42fbc-8b1a-44b0-a636-b91cd96205de"></script>
</head>
<body>
    <nav style="padding: 1rem 2rem; background: rgba(2, 6, 23, 0.9); backdrop-filter: blur(10px); border-bottom: 1px solid rgba(6, 182, 212, 0.2); display: flex; justify-content: space-between; align-items: center; z-index: 100; position: sticky; top: 0;">
        <a href="/" style="font-family: var(--font-title); font-weight: 700; font-size: 1.5rem; color: #fff; text-decoration: none; letter-spacing: -1px; display: flex; align-items: center; gap: 0.5rem;">
            <span style="color: var(--accent);">//</span> THE LOOP
        </a>
        <div style="display: flex; gap: 2rem; font-size: 0.8rem; letter-spacing: 1px;">
            <a href="/" style="color: var(--text-muted); text-decoration: none; transition: color 0.3s;" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--text-muted)'">HOME</a>
            <a href="/ultima" style="color: var(--text-muted); text-decoration: none; transition: color 0.3s;" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--text-muted)'">ULTIMA</a>
            <a href="/archivo" style="color: var(--text-muted); text-decoration: none; transition: color 0.3s;" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--text-muted)'">ARCHIVO</a>
        </div>
    </nav>
    <main class="container">
        <slot />
    </main>
</body>
</html>
