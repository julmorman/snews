---
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const newsFiles = import.meta.glob('../../content/news/*.json', { eager: true });
  const allNews = Object.values(newsFiles).flatMap((file: any) => file.default.noticias);
  
  return allNews.map((n) => {
    return {
      params: { id: n.id },
      props: { noticia: n },
    };
  });
}

const { noticia } = Astro.props;
---
<Layout title={noticia.titulo}>
    <div style="margin-top: 2rem;">
        <a href="/ultima" style="color: #94a3b8; text-decoration: none;">&larr; Volver a la presentación</a>
    </div>

    <article style="margin-top: 2rem;">
        <header style={`border-left: 8px solid ${noticia.color}; padding-left: 1rem; margin-bottom: 2rem;`}>
            <p style={`color: ${noticia.color}; font-weight: bold; text-transform: uppercase; margin: 0;`}>
                {noticia.categoria}
            </p>
            <h1 style="font-size: 2.5rem; margin: 0.5rem 0;">{noticia.titulo}</h1>
        </header>

        <div style="font-size: 1.25rem; line-height: 1.7; color: #f1f5f9; margin-bottom: 2rem;">
            {noticia.contexto_extendido.split('\n').map((paragraph: string) => {
                const isBullet = paragraph.trim().startsWith('*');
                const cleanText = isBullet ? paragraph.trim().substring(1).trim() : paragraph.trim();
                
                // Procesar negritas **texto**
                const parts = cleanText.split(/(\*\*.*?\*\*)/g);
                const content = parts.map(part => {
                    if (part.startsWith('**') && part.endsWith('**')) {
                        return <strong style="color: white; font-weight: 800;">{part.slice(2, -2)}</strong>;
                    }
                    return part;
                });

                if (isBullet) {
                    return <li style="margin-left: 1.5rem; margin-bottom: 0.5rem; list-style-type: disc;">{content}</li>;
                }
                if (cleanText === "") return null;
                return <p style="margin-bottom: 1rem;">{content}</p>;
            })}
        </div>

        <div style="margin-bottom: 3rem;">
            <img src={noticia.imagen} alt={noticia.titulo} style="width: 100%; max-height: 600px; object-fit: cover; border-radius: 1rem; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);" onerror="this.src='https://images.unsplash.com/photo-1504711434969-e33886168f5c?auto=format&fit=crop&w=1200&q=80'" />
        </div>

        <section style="background: #1e293b; padding: 2rem; border-radius: 1rem; border: 1px solid #334155;">
            <h2 style="font-size: 1.25rem; margin-top: 0; margin-bottom: 1rem;">Fuentes para contrastar la información:</h2>
            <div style="display: flex; flex-direction: column; gap: 1rem;">
                {noticia.enlaces.map((link) => (
                    <a 
                        href={link.url} 
                        target="_blank" 
                        rel="noopener noreferrer"
                        style="display: flex; align-items: center; gap: 0.5rem; padding: 1rem; background: #0f172a; border-radius: 0.5rem; text-decoration: none; color: white; border: 1px solid transparent; transition: all 0.2s;"
                        onmouseover="this.style.borderColor='#3b82f6'; this.style.transform='translateY(-2px)'"
                        onmouseout="this.style.transform='translateY(0)'; this.style.borderColor='transparent'"
                    >
                        <span style="font-weight: bold;">{link.nombre}</span>
                        <span style="color: #94a3b8; font-size: 0.9rem; text-overflow: ellipsis; overflow: hidden; white-space: nowrap; flex: 1;">
                            {link.url}
                        </span>
                        <span style="color: #3b82f6; font-weight: bold;">&nearrow;</span>
                    </a>
                ))}
            </div>
        </section>
    </article>
</Layout>
