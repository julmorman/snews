---
import Layout from '../layouts/Layout.astro';
---
<Layout title="S-NEWS | Bienvenido">
    <div style="text-align: center; padding: 4rem 0;">
        <h1 style="font-size: 4rem; margin-bottom: 1rem; background: linear-gradient(to right, #60a5fa, #34d399); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">S-NEWS</h1>
        <p style="font-size: 1.5rem; color: #94a3b8; max-width: 600px; margin: 0 auto 3rem;">
            Noticias que importan, explicadas para que formes tu propia opinión.
        </p>
        
        <div style="display: flex; gap: 1.5rem; justify-content: center; flex-wrap: wrap;">
            <a href="/snews/ultima" style="background: #3b82f6; color: white; padding: 1rem 2rem; border-radius: 0.5rem; text-decoration: none; font-weight: bold;">Ver Última Presentación</a>
            <a href="/snews/presentacion" target="_blank" style="background: #8b5cf6; color: white; padding: 1rem 2rem; border-radius: 0.5rem; text-decoration: none; font-weight: bold;">📺 Modo Pantallas (Loop)</a>
            <a href="/snews/archivo" style="background: #334155; color: white; padding: 1rem 2rem; border-radius: 0.5rem; text-decoration: none; font-weight: bold;">Explorar Archivo</a>
        </div>
    </div>
</Layout>
