---
import Layout from '../layouts/Layout.astro';
---
<Layout title="The Weekly Loop | Archivo">
    <h1 style="font-size: 3rem; margin-bottom: 2rem;">Archivo de Noticias</h1>
    
    <div style="display: flex; flex-direction: column; gap: 1rem;">
        <div style="background: #1e293b; padding: 1.5rem; border-radius: 1rem; border: 1px solid #334155; opacity: 1;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <h3 style="margin: 0;">Esa semana que casi conseguimos una tregua y nos mudamos a la Luna</h3>
                    <p style="color: #94a3b8; margin: 0.2rem 0 0;">20 Mayo - 27 Mayo 2026</p>
                </div>
                <a href="/snews/ultima" style="color: #60a5fa; text-decoration: none; font-weight: bold;">Ver noticias →</a>
            </div>
        </div>

        <div style="background: #1e293b; padding: 1.5rem; border-radius: 1rem; border: 1px solid #334155; opacity: 0.7;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <h3 style="margin: 0;">Esa semana que casi colonizamos la Luna (otra vez)</h3>
                    <p style="color: #94a3b8; margin: 0.2rem 0 0;">27 Abril - 04 Mayo 2026</p>
                </div>
                <span style="color: #64748b; font-weight: bold;">(Versión anterior)</span>
            </div>
        </div>
        
        <div style="background: #1e293b; padding: 1.5rem; border-radius: 1rem; border: 1px solid #334155; opacity: 0.5;">
            <p style="color: #94a3b8; margin: 0;">Próximamente más presentaciones...</p>
        </div>
    </div>
</Layout>
