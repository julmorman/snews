---
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    {import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN && (
        <script
            defer
            src="https://static.cloudflareinsights.com/beacon.min.js"
            data-cf-beacon={`{"token": "${import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN}"}`}
        ></script>
    )}
    <style is:global>
        @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;700&family=JetBrains+Mono:wght@400;700&display=swap');

        :root {
            --bg-color: #020617;
            --card-bg: #0f172a;
            --text-main: #f3f4f6;
            --text-muted: #9ca3af;
            --accent: #06b6d4;
            --accent-glow: rgba(6, 182, 212, 0.2);
            --font-title: 'Space Grotesk', sans-serif;
            --font-body: 'JetBrains Mono', monospace;
        }
        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: var(--font-body);
            margin: 0;
            padding: 0;
        }
        .container {
            max-width: 1000px;
            margin: 0 auto;
            padding: 2rem;
        }
        h1, h2, h3, h4, h5, h6 {
            font-family: var(--font-title);
        }
        .nav-links {
            display: flex;
            align-items: center;
            gap: 2rem;
            font-size: 0.8rem;
            letter-spacing: 1px;
        }
        .nav-link {
            color: var(--text-muted);
            text-decoration: none;
            transition: color 0.3s;
        }
        .nav-link:hover {
            color: var(--accent);
        }
        .nav-dropdown {
            position: relative;
        }
        .nav-dropdown-menu {
            display: none;
            position: absolute;
            top: 100%;
            left: 50%;
            transform: translateX(-50%);
            padding-top: 0.75rem;
        }
        .nav-dropdown:hover .nav-dropdown-menu {
            display: flex;
            flex-direction: column;
        }
        .nav-dropdown-item {
            background: #0f172a;
            border: 1px solid rgba(6, 182, 212, 0.2);
            color: var(--text-muted);
            text-decoration: none;
            padding: 0.6rem 1.25rem;
            white-space: nowrap;
            transition: color 0.3s, background 0.3s;
        }
        .nav-dropdown-item:hover {
            color: #fff;
            background: rgba(6, 182, 212, 0.15);
        }
        .nav-dropdown-item:first-child {
            border-radius: 0.5rem 0.5rem 0 0;
        }
        .nav-dropdown-item:last-child {
            border-radius: 0 0 0.5rem 0.5rem;
            border-top: none;
        }
    </style>
    <script defer src="https://cloud.umami.is/script.js" data-website-id="1fd42fbc-8b1a-44b0-a636-b91cd96205de"></script>
</head>
<body>
    <nav style="padding: 1rem 2rem; background: rgba(2, 6, 23, 0.9); backdrop-filter: blur(10px); border-bottom: 1px solid rgba(6, 182, 212, 0.2); display: flex; justify-content: space-between; align-items: center; z-index: 100; position: sticky; top: 0;">
        <a href="/" style="font-family: var(--font-title); font-weight: 700; font-size: 1.5rem; color: #fff; text-decoration: none; letter-spacing: -1px; display: flex; align-items: center; gap: 0.5rem;">
            <span style="color: var(--accent);">//</span> THE LOOP
        </a>
        <div class="nav-links">
            <a href="/" class="nav-link">HOME</a>
            <div class="nav-dropdown">
                <a href="/archivo" class="nav-link">ARCHIVO</a>
                <div class="nav-dropdown-menu">
                    <a href="/ultima" class="nav-dropdown-item">Última</a>
                    <a href="/archivo" class="nav-dropdown-item">Todas</a>
                </div>
            </div>
            <a href="/mas-informacion" class="nav-link">GLOSARIO</a>
        </div>
    </nav>
    <main class="container">
        <slot />
    </main>
</body>
</html>
