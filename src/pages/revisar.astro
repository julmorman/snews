---
import { getCollection } from 'astro:content';
import { SITE_TITLE } from '../config/constants';

const allEditions = await getCollection('news');
allEditions.sort((a, b) => b.id.localeCompare(a.id));
const latestEdition = allEditions[0];

if (!latestEdition) {
  return Astro.redirect('/');
}

const { data } = latestEdition;
---
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{SITE_TITLE} | Galería de Revisión</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;700;800;900&display=swap');
        body { background-color: #0f172a; color: white; font-family: 'Inter', sans-serif; padding: 2rem; margin: 0; }
        .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(350px, 1fr)); gap: 2rem; }
        .slide-preview { background: #020617; aspect-ratio: 16 / 9; border-radius: 1rem; border: 1px solid #334155; position: relative; overflow: hidden; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; padding: 1rem; }
        .label { margin-bottom: 0.5rem; color: #64748b; font-weight: bold; text-transform: uppercase; font-size: 0.7rem; }
        
        .m-title { font-size: 1.5rem; font-weight: 900; margin: 0; background: linear-gradient(to right, #60a5fa, #34d399); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .m-category { font-size: 0.6rem; font-weight: 900; text-transform: uppercase; letter-spacing: 2px; }
        .m-news-title { font-size: 1rem; font-weight: 800; margin: 0.3rem 0; }
        .m-summary { font-size: 0.7rem; color: #94a3b8; line-height: 1.3; }
        
        .m-detail { display: flex; gap: 0.8rem; text-align: left; width: 100%; height: 100%; align-items: center; }
        .m-img { width: 40%; height: 70%; object-fit: cover; border-radius: 0.5rem; background: #1e293b; }
        .m-text { flex: 1; }
        .m-bullets { list-style: none; padding: 0; font-size: 0.6rem; color: #cbd5e1; }
        .m-bullets li { margin-bottom: 0.2rem; }
        .m-bullets li::before { content: "→ "; color: white; font-weight: bold; }
    </style>
</head>
<body>
    <h1 style="margin-bottom: 0.5rem;">Galería de Diapositivas</h1>
    <p style="color: #94a3b8; margin-bottom: 2rem;">Revisión rápida para la edición del {data.date}</p>
    
    <div class="grid">
        <!-- Portada -->
        <div>
            <div class="label">0. Portada</div>
            <div class="slide-preview">
                <h1 class="m-title">THE LOOP</h1>
                <p style="font-size: 0.7rem; color: #94a3b8;">Noticias que importan...</p>
            </div>
        </div>

        {data.news.map((item, i) => (
            <>
                <div>
                    <div class="label">{(i*2)+1}. {item.category} (Título)</div>
                    <div class="slide-preview">
                        <div class="m-category" style={`color: ${item.color}`}>{item.category}</div>
                        <div class="m-news-title">{item.title}</div>
                        <div class="m-summary">{item.short_summary}</div>
                    </div>
                </div>
                <div>
                    <div class="label">{(i*2)+2}. {item.category} (Detalle)</div>
                    <div class="slide-preview">
                        <div class="m-detail">
                            <img src={item.image} class="m-img" onerror="this.style.background='#ef4444'" />
                            <div class="m-text">
                                <ul class="m-bullets">
                                    {item.context.split('\n').filter(l => l.trim().startsWith('*')).map(l => (
                                        <li>{l.replace('*', '').trim()}</li>
                                    ))}
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </>
        ))}

        <!-- Final -->
        <div>
            <div class="label">Final</div>
            <div class="slide-preview">
                <p style="color: #94a3b8; font-size: 0.7rem; margin: 0;">Conocé más en:</p>
                <p style="font-size: 1rem; font-weight: 900; margin: 0;">the-weekly-loop.vercel.app</p>
            </div>
        </div>
    </div>
</body>
</html>
