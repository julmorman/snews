---
import data from '../content/news/semana-01.json';
---
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>THE LOOP | Modo Presentación</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;700;800;900&display=swap');
        
        body, html {
            margin: 0; padding: 0; width: 100%; height: 100%;
            background-color: #020617; color: white;
            font-family: 'Inter', system-ui, sans-serif;
            overflow: hidden;
            cursor: pointer;
        }

        .slide {
            display: none;
            height: 100vh;
            width: 100vw;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 4rem;
            box-sizing: border-box;
            position: relative;
        }

        .slide.active { display: flex; animation: fadeIn 0.5s; }
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        
        /* Intro/Outro Slide */
        .intro-title { font-size: 8rem; font-weight: 900; background: linear-gradient(to right, #60a5fa, #34d399); -webkit-background-clip: text; -webkit-text-fill-color: transparent; margin: 0; }
        .intro-slogan { font-size: 2.5rem; color: #94a3b8; margin-top: 1rem; max-width: 800px; line-height: 1.4; }

        /* News Title Slide */
        .category { text-transform: uppercase; font-weight: 900; font-size: 2rem; letter-spacing: 4px; margin-bottom: 1rem; }
        .title { font-size: 5.5rem; line-height: 1.1; margin-bottom: 2rem; max-width: 90%; font-weight: 800; }
        .summary { font-size: 2.5rem; color: #94a3b8; max-width: 80%; line-height: 1.4; }

        /* News Detail Slide */
        .detail-container { display: flex; width: 100%; height: 100%; align-items: center; gap: 4rem; padding: 2rem; }
        .detail-image { flex: 1; height: 80vh; border-radius: 2rem; overflow: hidden; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5); background: #1e293b; }
        .detail-image img { width: 100%; height: 100%; object-fit: cover; }
        .detail-text { flex: 1; text-align: left; }
        .detail-context { font-size: 2rem; line-height: 1.5; color: #f1f5f9; margin-bottom: 2rem; }
        .detail-bullets { list-style: none; padding: 0; }
        .detail-bullets li { font-size: 1.8rem; margin-bottom: 1.5rem; position: relative; padding-left: 2.5rem; color: #cbd5e1; }
        .detail-bullets li::before { content: "→"; position: absolute; left: 0; color: #3b82f6; font-weight: bold; }

        .progress-container { position: absolute; bottom: 0; left: 0; width: 100%; height: 10px; background: #1e293b; }
        .progress-bar { height: 100%; background: #3b82f6; width: 0%; }
        .footer { position: absolute; bottom: 40px; right: 40px; font-size: 1.5rem; color: #475569; font-weight: bold; }
        
        #fullscreen-btn {
            position: absolute; top: 20px; right: 20px;
            background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2);
            color: white; padding: 10px 15px; border-radius: 5px;
            cursor: pointer; z-index: 1000; font-weight: bold; transition: opacity 0.3s;
        }
        .fullscreen-hidden #fullscreen-btn { opacity: 0; }
    </style>
</head>
<body>
    <button id="fullscreen-btn">PANTALLA COMPLETA</button>
    
    <div id="slides-container">
        <!-- Portada Inicial -->
        <div class="slide active" data-duration="15000">
            <h1 class="intro-title">THE LOOP</h1>
            <p class="intro-slogan">Noticias que importan, explicadas para que formes tu propia opinión.</p>
            <div class="footer">EDICIÓN {data.fecha}</div>
        </div>

        {data.noticias.map((item) => (
            <>
                <!-- Slide A: Título -->
                <div class="slide" data-color={item.color} data-duration="8000">
                    <div class="category" style={`color: ${item.color}`}>{item.categoria}</div>
                    <div class="title">{item.titulo}</div>
                    <div class="summary">{item.resumen_corto}</div>
                    <div class="footer">THE LOOP | {data.fecha}</div>
                </div>

                <!-- Slide B: Detalle -->
                <div class="slide" data-color={item.color} data-duration="8000">
                    <div class="detail-container">
                        <div class="detail-image">
                            <img src={item.imagen} alt={item.titulo} onerror="this.src='https://images.unsplash.com/photo-1504711434969-e33886168f5c?auto=format&fit=crop&w=1200&q=80'" />
                        </div>
                        <div class="detail-text">
                            <div class="category" style={`color: ${item.color}`}>{item.categoria}</div>
                            <div class="detail-context">
                                {item.contexto.split('\n').map((line) => {
                                    if (!line.trim().startsWith('*') && line.trim() !== "") {
                                        const parts = line.split(/(\*\*.*?\*\*)/g);
                                        return <p>{parts.map(part => {
                                            if (part.startsWith('**') && part.endsWith('**')) {
                                                return <strong style="color: white; font-weight: 800;">{part.slice(2, -2)}</strong>;
                                            }
                                            return part;
                                        })}</p>;
                                    }
                                    return null;
                                })}
                            </div>
                            <ul class="detail-bullets">
                                {item.contexto.split('\n').map((line) => {
                                    if (line.trim().startsWith('*')) {
                                        const cleanText = line.trim().substring(1).trim();
                                        const parts = cleanText.split(/(\*\*.*?\*\*)/g);
                                        return <li>{parts.map(part => {
                                            if (part.startsWith('**') && part.endsWith('**')) {
                                                return <strong style="color: white; font-weight: 800;">{part.slice(2, -2)}</strong>;
                                            }
                                            return part;
                                        })}</li>;
                                    }
                                    return null;
                                })}
                            </ul>
                        </div>
                    </div>
                </div>
            </>
        ))}

        <!-- Slide Final -->
        <div class="slide" data-duration="8000">
            <h1 class="intro-title">THE LOOP</h1>
            <p class="intro-slogan">Conocé más en: the-weekly-loop.vercel.app</p>
            <div class="footer">¡GRACIAS POR VER!</div>
        </div>
    </div>
    
    <div class="progress-container">
        <div class="progress-bar" id="progress"></div>
    </div>

    <script>
        const slides = document.querySelectorAll('.slide');
        const progressBar = document.getElementById('progress');
        const fullscreenBtn = document.getElementById('fullscreen-btn');
        let currentSlide = 0;
        let start = Date.now();

        function getDuration() {
            return parseInt(slides[currentSlide].getAttribute('data-duration') || "15000");
        }

        function update() {
            const duration = getDuration();
            const elapsed = Date.now() - start;
            const progress = (elapsed / duration) * 100;
            
            if (progress >= 100) {
                nextSlide();
            } else {
                progressBar.style.width = progress + '%';
                requestAnimationFrame(update);
            }
        }

        function nextSlide() {
            slides[currentSlide].classList.remove('active');
            currentSlide = (currentSlide + 1) % slides.length;
            slides[currentSlide].classList.add('active');
            
            const nextColor = slides[currentSlide].getAttribute('data-color') || "#3b82f6";
            progressBar.style.backgroundColor = nextColor;
            
            start = Date.now();
            requestAnimationFrame(update);
        }

        progressBar.style.backgroundColor = slides[0].getAttribute('data-color') || "#3b82f6";
        requestAnimationFrame(update);

        function toggleFullscreen() {
            if (!document.fullscreenElement) {
                document.documentElement.requestFullscreen();
                document.body.classList.add('fullscreen-hidden');
            } else {
                document.exitFullscreen();
                document.body.classList.remove('fullscreen-hidden');
            }
        }

        fullscreenBtn.onclick = (e) => { e.stopPropagation(); toggleFullscreen(); };
        document.body.onclick = () => { if (!document.fullscreenElement) toggleFullscreen(); };
    </script>
</body>
</html>
