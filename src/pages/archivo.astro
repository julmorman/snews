---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allEditions = await getCollection('news');
// Ordenar por ID descendente para que la más nueva aparezca primero
allEditions.sort((a, b) => b.id.localeCompare(a.id));
---

<Layout title="THE LOOP | Archivo de Ediciones">
    <header style="text-align: center; margin-bottom: 4rem; padding-top: 2rem;">
        <h1 style="font-size: 3.5rem; margin-bottom: 1rem; font-weight: 900;">Archivo</h1>
        <p style="color: #94a3b8; font-size: 1.2rem;">Revive todas las ediciones pasadas de The Loop.</p>
    </header>

    <div style="display: flex; flex-direction: column; gap: 1.5rem; max-width: 800px; margin: 0 auto;">
        {allEditions.map(edition => (
            <a href={`/archivo/${edition.id}`} style="text-decoration: none;">
                <div style="background: #1e293b; padding: 1.5rem 2.5rem; border-radius: 1rem; border: 1px solid #334155; transition: all 0.2s; display: flex; justify-content: space-between; align-items: center;" 
                     onmouseover="this.style.transform='translateX(10px)'; this.style.borderColor='#3b82f6'"
                     onmouseout="this.style.transform='translateX(0)'; this.style.borderColor='#334155'">
                    <div style="text-align: left;">
                        <h2 style="color: white; margin: 0; font-size: 1.4rem; font-weight: 800; display: flex; align-items: center; gap: 0.6rem;">
                            {edition.data.funny_title}
                            {edition.data.intro_label && (
                                <span style="color: #06b6d4; font-weight: 900; text-transform: uppercase; font-size: 0.7rem; letter-spacing: 2px; border: 1px solid #06b6d4; padding: 0.15rem 0.6rem; border-radius: 100px;">
                                    {edition.data.intro_label}
                                </span>
                            )}
                        </h2>
                        <p style="color: #94a3b8; margin: 0.2rem 0 0 0; font-size: 1rem;">{edition.data.date}</p>
                    </div>
                    <div style="color: #3b82f6; font-weight: bold; font-size: 1.2rem;">Explorar &rarr;</div>
                </div>
            </a>
        ))}
    </div>
</Layout>
