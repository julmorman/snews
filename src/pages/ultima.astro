---
import Layout from '../layouts/Layout.astro';
import EditionNewsGrid from '../components/EditionNewsGrid.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, SITE_TITLE, matchCategory } from '../config/constants';

// Obtener la edición más reciente
const allEditions = await getCollection('news');
allEditions.sort((a, b) => b.id.localeCompare(a.id));
const latestEdition = allEditions[0];

if (!latestEdition) {
  return Astro.redirect('/');
}

const { data } = latestEdition;

const glossaryEntries = await getCollection('glosario');
const glossaryMap = new Map(glossaryEntries.map(e => [e.data.id, e.data.term]));

// Agrupar noticias por categoría para esta vista
const groupedNews = CATEGORIES.map(cat => ({
    name: cat.label,
    color: cat.color,
    items: data.news
        .filter(n => matchCategory(n.category, cat.id))
        .map(n => ({
            ...n,
            relatedTerms: (n.related_terms || [])
                .filter(id => glossaryMap.has(id))
                .map(id => ({ id, term: glossaryMap.get(id)! })),
        })),
})).filter(group => group.items.length > 0);
---

<Layout title={`${SITE_TITLE} | ${data.funny_title}`}>
    <header style="text-align: center; margin-bottom: 3rem;">
        <h1 style="font-size: 3rem; margin: 0.5rem 0;">{data.funny_title}</h1>
        <p style="color: #94a3b8;">{data.date}</p>
    </header>

    <EditionNewsGrid groupedNews={groupedNews} editionId={latestEdition.id} editionLabel={data.funny_title} />
</Layout>
