---
import data from '../content/news/semana-01.json';
---
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>THE LOOP | Modo Presentación</title>
    <style>
        body, html {
            margin: 0; padding: 0; width: 100%; height: 100%;
            background-color: #020617; color: white;
            font-family: 'Inter', system-ui, sans-serif;
            overflow: hidden;
            cursor: pointer;
        }
        .slide {
            display: none;
            height: 100vh;
            width: 100vw;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 4rem;
            box-sizing: border-box;
            position: relative;
        }
        .slide.active { display: flex; animation: fadeIn 0.5s; }
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        
        .category {
            text-transform: uppercase;
            font-weight: 900;
            font-size: 2rem;
            letter-spacing: 4px;
            margin-bottom: 1rem;
        }
        .title { font-size: 5rem; line-height: 1.1; margin-bottom: 2rem; max-width: 90%; font-weight: 800; }
        .summary { font-size: 2.5rem; color: #94a3b8; max-width: 80%; line-height: 1.4; }
        
        .progress-container {
            position: absolute; bottom: 0; left: 0;
            width: 100%; height: 10px; background: #1e293b;
        }
        .progress-bar {
            height: 100%; background: #3b82f6; width: 0%;
        }
        .footer {
            position: absolute; bottom: 40px; right: 40px;
            font-size: 1.5rem; color: #475569; font-weight: bold;
        }
        #fullscreen-btn {
            position: absolute;
            top: 20px;
            right: 20px;
            background: rgba(255,255,255,0.1);
            border: 1px solid rgba(255,255,255,0.2);
            color: white;
            padding: 10px 15px;
            border-radius: 5px;
            cursor: pointer;
            z-index: 1000;
            font-weight: bold;
            transition: opacity 0.3s;
        }
        body:hover #fullscreen-btn { opacity: 1; }
        .fullscreen-hidden #fullscreen-btn { opacity: 0; }
    </style>
</head>
<body>
    <button id="fullscreen-btn">PANTALLA COMPLETA</button>
    <div id="slides-container">
        {data.noticias.map((item, index) => (
            <div class={`slide ${index === 0 ? 'active' : ''}`} data-color={item.color}>
                <div class="category" style={`color: ${item.color}`}>{item.categoria}</div>
                <div class="title">{item.titulo}</div>
                <div class="summary">{item.resumen_corto}</div>
                <div class="footer">THE LOOP | {data.fecha}</div>
            </div>
        ))}
    </div>
    
    <div class="progress-container">
        <div class="progress-bar" id="progress"></div>
    </div>

    <script>
        const slides = document.querySelectorAll('.slide');
        const progressBar = document.getElementById('progress');
        const fullscreenBtn = document.getElementById('fullscreen-btn');
        let currentSlide = 0;
        const duration = 15000; // 15 segundos por slide
        let start = Date.now();

        function update() {
            const elapsed = Date.now() - start;
            const progress = (elapsed / duration) * 100;
            
            if (progress >= 100) {
                nextSlide();
            } else {
                progressBar.style.width = progress + '%';
                requestAnimationFrame(update);
            }
        }

        function nextSlide() {
            slides[currentSlide].classList.remove('active');
            currentSlide = (currentSlide + 1) % slides.length;
            slides[currentSlide].classList.add('active');
            
            // Cambiar color de la barra de progreso
            const nextColor = slides[currentSlide].getAttribute('data-color');
            progressBar.style.backgroundColor = nextColor;
            
            start = Date.now();
            requestAnimationFrame(update);
        }

        // Iniciar
        progressBar.style.backgroundColor = slides[0].getAttribute('data-color');
        requestAnimationFrame(update);

        // Función para pantalla completa
        function toggleFullscreen() {
            if (!document.fullscreenElement) {
                document.documentElement.requestFullscreen().catch(err => {
                    console.error(`Error al intentar activar pantalla completa: ${err.message}`);
                });
                document.body.classList.add('fullscreen-hidden');
                fullscreenBtn.innerText = 'SALIR';
            } else {
                document.exitFullscreen();
                document.body.classList.remove('fullscreen-hidden');
                fullscreenBtn.innerText = 'PANTALLA COMPLETA';
            }
        }

        fullscreenBtn.onclick = (e) => {
            e.stopPropagation();
            toggleFullscreen();
        };

        // También al hacer clic en cualquier parte del fondo si no es pantalla completa
        document.body.onclick = () => {
            if (!document.fullscreenElement) {
                toggleFullscreen();
            }
        };

        // Escuchar cambios de pantalla completa para ajustar el botón
        document.addEventListener('fullscreenchange', () => {
            if (!document.fullscreenElement) {
                document.body.classList.remove('fullscreen-hidden');
                fullscreenBtn.innerText = 'PANTALLA COMPLETA';
            }
        });
    </script>
</body>
</html>
