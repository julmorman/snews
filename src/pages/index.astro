---
import Layout from '../layouts/Layout.astro';
---
<Layout title="The Loop | Dashboard">
    <div class="cyber-container">
        <div class="cyber-header">
            <div class="system-status">
                <span class="status-dot"></span> SYSTEM: ONLINE // SESSION: ACTIVE
            </div>
            <div class="date-display">04-JUNIO-2026</div>
        </div>

        <div class="cyber-main">
            <h1 class="cyber-title">THE LOOP</h1>
            <p class="cyber-subtitle">
                Noticias que importan, explicadas para que formes tu propia opinión.
            </p>
            
            <div class="cyber-grid">
                <a href="/ultima" class="cyber-card">
                    <div class="card-tag">LATEST</div>
                    <div class="card-content">
                        <h3>Ver Última Edición</h3>
                        <p>Acceso directo al contenido más reciente.</p>
                    </div>
                    <div class="card-footer">STATUS: READY</div>
                </a>
                
                <a href="/presentacion" target="_blank" class="cyber-card primary">
                    <div class="card-tag">LAUNCH</div>
                    <div class="card-content">
                        <h3>Iniciar Loop</h3>
                        <p>Modo presentación cinematográfico.</p>
                    </div>
                    <div class="card-footer">MODE: AUTO-PLAY</div>
                </a>

                <a href="/archivo" class="cyber-card">
                    <div class="card-tag">DATABASE</div>
                    <div class="card-content">
                        <h3>Explorar Archivo</h3>
                        <p>Historial completo de ediciones pasadas.</p>
                    </div>
                    <div class="card-footer">QUERY: ALL</div>
                </a>
            </div>
        </div>

        <div class="cyber-footer">
            <div class="version">v2.4.0-STABLE</div>
            <div class="copyright">© 2026 THE LOOP PROJECT</div>
        </div>
    </div>
</Layout>

<style>
    @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;700&family=JetBrains+Mono:wght@400;700&display=swap');

    :root {
        --bg-color: #020617;
        --text-main: #f3f4f6;
        --text-muted: #9ca3af;
        --accent: #06b6d4;
        --accent-glow: rgba(6, 182, 212, 0.4);
        --purple-accent: #8b5cf6;
        --font-title: 'Space Grotesk', sans-serif;
        --font-body: 'JetBrains Mono', monospace;
    }

    .cyber-container {
        min-height: 80vh;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 2rem;
        background-color: var(--bg-color);
        background-image: 
            linear-gradient(var(--accent-glow) 1px, transparent 1px),
            linear-gradient(90deg, var(--accent-glow) 1px, transparent 1px);
        background-size: 30px 30px;
        background-position: center;
        border: 1px solid rgba(6, 182, 212, 0.2);
        border-radius: 1rem;
        font-family: var(--font-body);
        color: var(--text-main);
        position: relative;
        overflow: hidden;
    }

    .cyber-container::after {
        content: "";
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: radial-gradient(circle at center, transparent 0%, var(--bg-color) 80%);
        pointer-events: none;
    }

    .cyber-header, .cyber-main, .cyber-footer {
        position: relative;
        z-index: 1;
    }

    .cyber-header {
        display: flex;
        justify-content: space-between;
        font-size: 0.8rem;
        letter-spacing: 2px;
        color: var(--accent);
        border-bottom: 1px solid rgba(6, 182, 212, 0.3);
        padding-bottom: 1rem;
    }

    .status-dot {
        display: inline-block;
        width: 8px;
        height: 8px;
        background: var(--accent);
        border-radius: 50%;
        margin-right: 8px;
        box-shadow: 0 0 10px var(--accent);
        animation: blink 1.5s infinite;
    }

    @keyframes blink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.3; }
    }

    .cyber-main {
        padding: 4rem 0;
        text-align: center;
    }

    .cyber-title {
        font-family: var(--font-title);
        font-size: 6rem;
        font-weight: 700;
        margin: 0;
        letter-spacing: -2px;
        color: #fff;
        text-shadow: 
            0 0 10px var(--accent-glow),
            0 0 20px rgba(6, 182, 212, 0.2);
    }

    .cyber-subtitle {
        font-size: 1.1rem;
        color: var(--text-muted);
        max-width: 600px;
        margin: 1rem auto 4rem;
        line-height: 1.6;
    }

    .cyber-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 2rem;
        max-width: 1000px;
        margin: 0 auto;
    }

    .cyber-card {
        background: rgba(15, 23, 42, 0.6);
        border: 1px solid rgba(6, 182, 212, 0.2);
        padding: 1.5rem;
        text-align: left;
        text-decoration: none;
        color: inherit;
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 200px;
        backdrop-filter: blur(4px);
    }

    .cyber-card:hover {
        border-color: var(--accent);
        box-shadow: 0 0 20px var(--accent-glow);
        transform: translateY(-5px);
        background: rgba(6, 182, 212, 0.05);
    }

    .cyber-card.primary {
        border-color: var(--purple-accent);
    }

    .cyber-card.primary:hover {
        border-color: #a78bfa;
        box-shadow: 0 0 20px rgba(167, 139, 250, 0.3);
    }

    .card-tag {
        font-size: 0.7rem;
        color: var(--accent);
        font-weight: bold;
        letter-spacing: 2px;
        margin-bottom: 1rem;
    }

    .cyber-card.primary .card-tag {
        color: #a78bfa;
    }

    .card-content h3 {
        font-family: var(--font-title);
        font-size: 1.5rem;
        margin: 0 0 0.5rem 0;
        color: #fff;
    }

    .card-content p {
        font-size: 0.9rem;
        color: var(--text-muted);
        margin: 0;
    }

    .card-footer {
        margin-top: 2rem;
        font-size: 0.7rem;
        color: rgba(6, 182, 212, 0.5);
        border-top: 1px solid rgba(6, 182, 212, 0.1);
        padding-top: 0.8rem;
    }

    .cyber-footer {
        display: flex;
        justify-content: space-between;
        font-size: 0.7rem;
        color: rgba(6, 182, 212, 0.4);
        padding-top: 1rem;
        border-top: 1px solid rgba(6, 182, 212, 0.1);
    }
</style>
