---
import NewsCard from './NewsCard.astro';

interface RelatedTerm {
  id: string;
  term: string;
}

interface Props {
  groupedNews: {
    name: string;
    color: string;
    items: Array<{
      id: string;
      title: string;
      short_summary: string;
      category: string;
      image: string;
      relatedTerms?: RelatedTerm[];
    }>;
  }[];
  editionId: string;
  editionLabel: string;
}

const { groupedNews, editionId, editionLabel } = Astro.props;
const infoQuery = `from=${encodeURIComponent(editionId)}&fromLabel=${encodeURIComponent(editionLabel)}`;
---

<div class="edition-grid">
    {groupedNews.map((group, i) => {
        const hasInfo = group.items.some(item => item.relatedTerms && item.relatedTerms.length > 0);
        return (
            <div class={`category-group ${hasInfo ? 'with-info' : 'no-info'}`}>
                <div class="category-header" style={i === 0 ? 'margin-top: 0.5rem;' : ''}>
                    <h2 class="category-title" style={`color: ${group.color}`}>{group.name}</h2>
                    {hasInfo && (
                        <div class="more-info-label">
                            <span class="more-info-icon">ⓘ</span> Más información
                        </div>
                    )}
                </div>
                <div class="category-items">
                    {group.items.map(item => (
                        <>
                            <NewsCard item={item} showCategory={false} />
                            {hasInfo && (
                                <div class="info-buttons">
                                    {item.relatedTerms && item.relatedTerms.map(t => (
                                        <a href={`/mas-informacion/${t.id}?${infoQuery}`} class="info-btn">{t.term}</a>
                                    ))}
                                </div>
                            )}
                        </>
                    ))}
                </div>
            </div>
        );
    })}
</div>

<style>
    .category-header {
        display: grid;
        grid-template-columns: 1fr 170px;
        gap: 1.5rem;
        margin: 2.5rem 0 0.5rem;
    }

    .no-info .category-header {
        grid-template-columns: 1fr;
    }

    .category-title {
        text-transform: uppercase;
        letter-spacing: 2px;
        font-weight: 900;
        border-bottom: 2px solid #1e293b;
        padding-bottom: 0.5rem;
        margin: 0;
    }

    .more-info-label {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #60a5fa;
        font-weight: 900;
        white-space: nowrap;
        border-bottom: 2px solid #1e293b;
        padding-bottom: 0.5rem;
    }

    .more-info-icon {
        font-size: 0.95rem;
    }

    .category-items {
        display: grid;
        grid-template-columns: 1fr 170px;
        gap: 1rem 1.5rem;
        align-items: stretch;
    }

    .no-info .category-items {
        grid-template-columns: 1fr;
    }

    .info-buttons {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 0.4rem;
    }

    .info-btn {
        color: #93c5fd;
        text-decoration: none;
        font-size: 0.8rem;
        padding: 0.2rem 0;
        border-bottom: 1px solid transparent;
        line-height: 1.3;
    }

    .info-btn:hover {
        color: #fff;
        border-bottom-color: #3b82f6;
    }

    .info-btn::before {
        content: "+ ";
        color: #3b82f6;
    }

    @media (max-width: 700px) {
        .category-header {
            grid-template-columns: 1fr;
        }
        .category-items {
            grid-template-columns: 1fr;
        }
        .more-info-label {
            display: none;
        }
        .info-buttons {
            flex-direction: row;
            flex-wrap: wrap;
            gap: 0.75rem 1rem;
            margin: 0 0 0.5rem;
        }
    }
</style>
